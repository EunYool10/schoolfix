# OPENAI_API_KEY: Required for the AI safety-report analysis (POST /api/ai/analyze).
# Models used: gpt-5.6-terra (primary) -> gpt-5.6-luna (fallback).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Cloud OAuth 2.0 Web Client ID
# Configured in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""

# Google Cloud OAuth 2.0 Client Secret (Server-side ONLY, never exposed to client)
GOOGLE_CLIENT_SECRET=""

# Google Cloud OAuth 2.0 Authorized Redirect URI (optional, e.g. http://localhost:3000 or production app URL)
GOOGLE_REDIRECT_URI=""

# School Admin Email (comma-separated if multiple)
ADMIN_EMAILS="eunyool100208@gmail.com"
