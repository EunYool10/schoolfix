# SchoolFix AI 환경 변수
#
# 실제 값은 .env.local 에 넣습니다. (.gitignore 로 커밋에서 제외됨)
# 아래 항목이 이 프로젝트 코드가 실제로 읽는 전부입니다.

# ── OpenAI API 키 ────────────────────────────────────────────────
# 사용처: 신고 접수 시 위험도 분석, AI 요약
# 없으면 두 기능만 비활성화되고 신고 등록·조회·검색·PDF·인쇄는 정상 동작합니다.
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ── 외부 영구 저장소 (Supabase) ─────────────────────────────────
# 둘 다 설정하면 신고와 학교 추가 신청을 Supabase에 저장합니다.
# Supabase Dashboard의 Project URL과 서버 전용 Secret key(sb_secret_...)를 입력합니다.
# Secret key는 브라우저 코드에 넣거나 커밋하지 마세요.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Supabase를 반드시 사용해야 하는 배포 환경에서는 true로 설정합니다.
# 연결 설정이 빠지면 서버가 로컬 JSON으로 조용히 전환하지 않고 시작을 거부합니다.
REQUIRE_SUPABASE_STORE="false"
# 구형 service_role JWT를 사용할 때만 위 Secret key 대신 설정하세요.
# SUPABASE_SERVICE_ROLE_KEY=""
# 신고 사진을 넣을 비공개 Storage 버킷 이름. 없으면 서버가 시작할 때 만듭니다(기본 report-photos).
# Supabase를 쓰지 않으면 사진은 DATA_DIR/photos 에 저장됩니다.
# SUPABASE_PHOTO_BUCKET="report-photos"

# ── 관리자 비밀번호 해시 (신고 삭제 전용) ────────────────────────
# 신고 삭제는 이 해시와 대조해 인증합니다. 없으면 삭제 기능이 503 을 반환합니다.
# 평문 비밀번호는 저장하지 않습니다. bcrypt 해시만 넣으세요.
#
# 해시 생성:
#   node -e "console.log(require('bcryptjs').hashSync('원하는비밀번호', 12))"
ADMIN_PASSWORD_HASH=""

# ── 운영진 로그인 비밀번호 해시 ─────────────────────────────────
# 운영진 화면 로그인 및 신고 처리 상태 변경에 사용합니다.
# 관리자 삭제 비밀번호와 별도로 설정하며 평문은 저장하지 않습니다.
STAFF_PASSWORD_HASH=""

# 학교별 교사 로그인 비밀번호의 bcrypt 해시를 학교 ID별 JSON 객체로 설정합니다.
# 예: SCHOOL_TEACHER_PASSWORD_HASHES='{"cem-h":"$2b$12$..."}'
SCHOOL_TEACHER_PASSWORD_HASHES="{}"

# ── 운영진 알림 (선택) ───────────────────────────────────────────
# 긴급 신고 접수, 새 학교 추가 신청, 매달 초 지난달 월간 보고를 이 웹훅 주소로 보냅니다.
# 알림 종류는 운영진 화면 → "알림" 탭에서 켜고 끌 수 있고, 테스트 알림도 보낼 수 있습니다.
#  - Discord: 채널 설정 > 연동 > 웹후크 URL (https://discord.com/api/webhooks/...)
#  - Slack:   Incoming Webhook URL (https://hooks.slack.com/...)
#  - 카카오톡·이메일: Make·Zapier 등에서 받은 웹훅 주소를 넣고 그 도구에서 전달하세요.
# 비워 두면 알림을 보내지 않습니다. 웹훅 주소는 비밀번호처럼 다루고 커밋하지 마세요.
NOTIFY_WEBHOOK_URL=""
# 알림 기준 위험도: 긴급(기본) / 높음 / 중간 / 낮음 — 이 등급 이상이면 보냅니다.
NOTIFY_MIN_RISK="긴급"
# 알림 메시지에 붙일 사이트 주소 (예: https://schoolfix.onrender.com)
PUBLIC_BASE_URL=""

# ── 선택 항목 ────────────────────────────────────────────────────
# DATA_DIR: JSON 저장 경로. 영구 디스크를 쓸 때만 지정합니다(예: /var/data).
#           미지정 시 프로젝트의 data/ 를 사용하고, 없으면 부팅 시 생성합니다.
# DATA_DIR=""

# ALLOWED_ORIGINS: 교차 출처 요청을 허용할 도메인(쉼표 구분).
#                  프론트엔드와 API 가 같은 오리진이므로 보통 비워 둡니다.
# ALLOWED_ORIGINS=""

# PORT: 호스팅 플랫폼이 자동 주입합니다. 로컬 기본값 3000.
# NODE_ENV: development(Vite 개발 서버) / production(dist 정적 서빙)
# DISABLE_HMR: true 로 두면 Vite 파일 감시를 끕니다(개발 중 CPU 절약).

